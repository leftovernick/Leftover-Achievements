[Unit]
Description=LeftoverAchievements FastAPI backend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# Reference template; bootstrap generates this without manual editing.
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/.local/share/LeftoverAchievements/app/current
Environment=LEFTOVER_RUNTIME_MODE=raspberry_pi
Environment=LEFTOVER_DATA_DIR=/home/YOUR_USER/.local/share/LeftoverAchievements/data
EnvironmentFile=-/home/YOUR_USER/.local/share/LeftoverAchievements/data/.env
ExecStart=/home/YOUR_USER/.local/share/LeftoverAchievements/app/current/scripts/start-backend.sh
Restart=on-failure
RestartSec=3
# Uvicorn normally exits well before this; retain a systemd-level safety net.
TimeoutStopSec=12s

[Install]
WantedBy=multi-user.target
