[Unit]
Description=LeftoverAchievements FastAPI backend
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# Replace YOUR_USER and the project path below before installing this unit.
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/LeftoverAchievements
EnvironmentFile=/home/YOUR_USER/LeftoverAchievements/.env
ExecStart=/home/YOUR_USER/LeftoverAchievements/scripts/start-backend.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
